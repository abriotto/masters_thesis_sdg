# Ignore AIWolf completely
aiwolf_analysis/

# Ignore Werewolf Data/Models (Large files)
werebench_persuasion/data/
werebench_persuasion/models/
werebench_persuasion/outputs/

data/lai2023

# Raw downloaded datasets: reproducible via src/finetuning/download_jin.py
#
# Exception: the 120 Jin et al. ONUW episodes ARE tracked. The cluster jobs read
# them directly and a gitignored corpus meant the diagnostic jobs loaded their
# models and then died on the first data read. Nothing else under data/raw/ is
# tracked -- lai2023 in particular is large and stays ignored.
#
# A negation cannot re-include a file whose parent directory is excluded, so each
# level down to gpt4_dataset/ is unignored in turn. This is the same shape as the
# slurm_files rule below.
data/raw/*
!data/raw/jin2024_onuw/
data/raw/jin2024_onuw/*
!data/raw/jin2024_onuw/gpt4_dataset/

logs/
# Ignore slurm scripts by default, but track the finetuning ones so they reach
# the cluster via git. Negation requires globbing the contents rather than the
# directory: git cannot re-include a file whose parent directory is excluded.
slurm_files/*
!slurm_files/ft_*.slurm
!slurm_files/justification_annotation_pilot.slurm
!slurm_files/justification_annotation_full.slurm
!slurm_files/dv_*.slurm
unsloth_compiled_cache/

# Finetuned adapters live on the cluster, not in git.
models/
results/voting/openai_gpt-oss-20b/prompt_v1
results/voting/openai_gpt-oss-20b/prompt_v2
results/voting/google_gemma-4-31B-it/prompt_v2_8bit
results/voting/google_gemma-4-31B-it
results/voting/openai_gpt-oss-20b

.claude
THESIS_PROGRESS_REPORT.md

# Session handoff notes: working documents for picking work back up, not
# part of the thesis or the analysis pipeline.
DISCOURSE_PIPELINE_FINAL_HANDOFF.md

# Compiled bytecode. These were tracked for a long time despite this rule --
# .gitignore does not apply to files already in the index -- so every machine
# that ran Python produced a phantom local change that blocked git pull.
# Untracked with `git rm -r --cached`; the files themselves are regenerated.
__pycache__/
*.pyc
# Windows shortcut files: desktop conveniences, not project content.
*.lnk

# Working spec for the derivation-trace training pipeline, not thesis content.
derivation_trace_spec.md
